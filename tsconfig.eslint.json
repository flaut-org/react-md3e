{
  "extends": "./tsconfig.tooling.json",
  "include": [
    "packages/react-md3e/src/**/*.ts",
    "packages/react-md3e/src/**/*.tsx",
    "apps/next-fixture/app/**/*.ts",
    "apps/next-fixture/app/**/*.tsx",
    "apps/next-fixture/next.config.ts",
    ".storybook/**/*.ts",
    ".storybook/**/*.tsx",
    "stories/**/*.tsx",
    "vite.*.config.ts",
    "playwright*.config.ts",
