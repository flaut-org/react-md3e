{
  "name": "react-md3e-workspace",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.20.0",
  "engines": {
    "node": "^26.13.1",
    "npm": "^11.20.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build --workspace=@flaut-travel/react-md3e",
    "build:fixture": "npm run build --workspace=@react-md3e/next-fixture",
    "dev": "npm run build && npm run dev --workspace=@react-md3e/next-fixture",
    "dev:library": "npm run dev --workspace=@flaut-travel/react-md3e",
    "lint": "eslint . --max-warnings=0",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "typecheck": "npm run typecheck --workspaces --if-present && tsc --project tsconfig.tooling.json && tsc --project packages/react-md3e/tests/types-consumer/tsconfig.nodenext.json && tsc --project packages/react-md3e/tests/types-consumer/tsconfig.bundler.json",
    "check:package": "node scripts/check-package.mjs",
    "test": "node --test packages/react-md3e/src/theme/tests/*.test.mjs packages/react-md3e/src/internal/indicators/tests/*.test.mjs packages/react-md3e/src/components/badge/tests/*.test.mjs packages/react-md3e/src/components/calendar/tests/*.test.mjs packages/react-md3e/src/components/range-calendar/tests/*.test.mjs packages/react-md3e/src/components/slider/tests/*.test.mjs apps/next-fixture/tests/fixture.test.mjs",
    "check": "npm run format:check && npm run build && npm run lint && npm run typecheck && npm run check:package && npm run build:fixture && npm run build:storybook && npm test && npm run test:release && npm run test:browser",
    "pack": "npm pack --workspace=@flaut-travel/react-md3e",
    "postbuild": "node scripts/generate-example-themes.mjs",
    "storybook": "npm run build && storybook dev --port 6006 --disable-telemetry",
    "build:storybook": "storybook build --disable-telemetry",
    "serve:storybook": "vite preview --outDir storybook-static --host 127.0.0.1 --port 6006 --strictPort",
    "test:browser": "playwright test",
    "changeset": "changeset",
    "version-packages": "node scripts/release.mjs version",
    "release:alpha": "node scripts/release.mjs alpha",
    "release:beta": "node scripts/release.mjs beta",
    "release:stable": "node scripts/release.mjs stable",
    "release:check": "node scripts/release.mjs check",
    "release": "node scripts/release.mjs publish",
    "test:release": "node --test scripts/tests/release.test.mjs",
    "release:ci": "npm run build && npm run check:package && npm run release"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@changesets/cli": "3.0.3",
    "@eslint/js": "9.39.5",
    "@fontsource/roboto": "5.3.0",
    "@linaria/core": "8.3.0",
    "@material/material-color-utilities": "0.4.0",
    "@playwright/test": "1.65.1",
    "@storybook/addon-a11y": "10.6.7",
    "@storybook/addon-docs": "10.6.7",
    "@storybook/react-vite": "10.6.7",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@wyw-in-js/vite": "2.7.1",
    "csstype": "3.2.3",
    "eslint": "9.39.5",
    "eslint-config-airbnb-extended": "3.3.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "rollup-plugin-preserve-directives": "0.4.0",
    "storybook": "10.6.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2",
    "vite": "7.3.8"
  }
}
